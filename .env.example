# Gemini: API_KEY is the legacy-compatible canonical name.
API_KEY=
# Optional compatibility aliases. Set only if your deployment needs them.
GEMINI_API_KEY=
GOOGLE_API_KEY=

OPENWEATHER_API_KEY=
NEWS_API_KEY=
EMAIL=
EMAIL_APP_PASSWORD=

# Optional runtime configuration
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CONNECT_TIMEOUT=3
GEMINI_READ_TIMEOUT=12
GEMINI_MAX_OUTPUT_TOKENS=120

# Optional allowlisted desktop application paths
JARVIS_POWERPOINT_PATH=
JARVIS_CHROME_PATH=
JARVIS_GITHUB_PATH=
JARVIS_WHATSAPP_PATH=
JARVIS_CMD_PATH=
